# --- secrets: never commit. The vault contract keeps these out of the vault too.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# --- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend
node_modules/
dist/
build/
.next/
*.tsbuildinfo
.vite/

# --- editors & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- never let the vault land inside this repo (see README: two repos, never nested)
vault/
obsidian-vault/
*.md.bak

# --- machine-local runtime: config, state, and failure logs.
#     These are not secrets, but they are not shareable either: the config holds
#     the privacy denylist (which names the very client it exists to hide), the
#     state file lists covered session logs by filename, and the logs record
#     skipped paths. All three name private working directories. The code is the
#     artifact worth versioning; this is one machine's operating state. Ship
#     .example files instead so a fresh clone knows what to fill in.
runtime/*.config.json
!runtime/*.config.example.json
runtime/*.state.json
runtime/*.log
